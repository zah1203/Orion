[Unit]
Description=Orion opted-in Live account alerts
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/orion/portal.env
ConditionPathExists=/etc/orion/portal.key

[Service]
Type=simple
User=orion
Group=orion
WorkingDirectory=/opt/orion/current
EnvironmentFile=/etc/orion/portal.env
ExecStart=/opt/orion/current/.venv/bin/python -m orion.live.notifications
KillSignal=SIGINT
TimeoutStopSec=35
Restart=on-failure
RestartSec=15
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/orion/portal

[Install]
WantedBy=multi-user.target
