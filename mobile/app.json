{
  "expo": {
    "name": "Orion Paper",
    "slug": "orion-paper",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.orionpaper.app"
    },
    "android": {
      "package": "com.orionpaper.app"
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      "expo-notifications"
    ],
    "scheme": "orionpaper"
  }
}
